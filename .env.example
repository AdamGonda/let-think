# Convex - populated automatically when you run `npx convex dev`
VITE_CONVEX_URL=
# Frontend origin used by Convex auth callbacks (set in Convex env for each deployment):
#   local:  http://localhost:5173
#   prod:   https://<your-netlify-site>.netlify.app (or custom domain)
SITE_URL=
# Server-side (Convex deployment) - set via `npx convex env set` or Dashboard:
#   GOOGLE_GENERATIVE_AI_API_KEY - for Gemini 3.1 Pro Preview
#   AUTH_GOOGLE_ID - Google OAuth client ID (from Google Cloud Console)
#   AUTH_GOOGLE_SECRET - Google OAuth client secret
#
# Spotify (OAuth + Web API from Convex actions; callback is Convex HTTP):
#   SPOTIFY_CLIENT_ID - Spotify Developer Dashboard
#   SPOTIFY_CLIENT_SECRET - optional (confidential client); omit for public PKCE-only
#   SPOTIFY_REDIRECT_URI - must match Dashboard exactly, e.g.
#     https://YOUR_DEPLOYMENT.convex.site/spotify/callback
#   SPOTIFY_FRONTEND_ORIGIN or FRONTEND_ORIGIN - where to redirect after OAuth, e.g.
#     http://localhost:5173  (production app URL in prod)

# Add other client-safe env vars with VITE_ prefix, e.g.:
# VITE_APP_NAME=think
