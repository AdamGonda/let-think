# Local dev — Vite reads `.env.local` (created when you run `npx convex dev`)
VITE_CONVEX_URL=

# Convex Dashboard (or `npx convex env set`) — must match each deployment (dev/prod).
# Used by `convex/auth.config.ts` for @convex-dev/auth JWT issuer domain.
#   Local:  http://localhost:5173
#   Prod:   https://<your-netlify-site>.netlify.app (or custom domain)
CONVEX_SITE_URL=

# Convex server-side only (Dashboard or `npx convex env set`):
#   GOOGLE_GENERATIVE_AI_API_KEY — Gemini for chat actions and topic summaries
#   AUTH_GOOGLE_ID — Google OAuth client ID (Google Cloud Console)
#   AUTH_GOOGLE_SECRET — Google OAuth client secret
#   CONVEX_ADMIN_EMAILS — comma-separated admin emails for beta controls
#   RESEND_API_KEY — Resend API key for transactional email sends
#   RESEND_FROM_EMAIL — sender identity, e.g. Let Think <noreply@yourdomain.com>
#   RESEND_REPLY_TO — optional reply-to address for transactional emails
#
# Add other client-safe values in `.env.local` with the VITE_ prefix only, e.g.:
# VITE_APP_NAME=let-think
# PostHog (client-side analytics):
# VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# VITE_PRODUCT_DEMO_YOUTUBE_ID=dQw4w9WgXcQ
# Optional fallback if YouTube ID is not set:
# VITE_PRODUCT_DEMO_VIDEO_URL=/demo.mp4
# VITE_PRODUCT_DEMO_VIDEO_POSTER_URL=/demo-poster.jpg
