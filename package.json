{
  "name": "let-think",
  "private": true,
  "version": "0.0.43",
  "type": "module",
  "scripts": {
    "prepare": "sh scripts/install-git-hooks.sh",
    "dev": "concurrently -n vite,convex -c blue,green \"vite --host\" \"npx convex dev\"",
    "dev:convex": "npx convex dev",
    "build": "tsc -b && vite build",
    "build:analyze": "ANALYZE=true tsc -b && ANALYZE=true vite build",
    "typecheck:ci": "tsc -p tsconfig.ci.json --pretty false",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "----------": "node -e \"void 0\"",
    "prepare:local": "varlock run -- sh scripts/install-git-hooks.sh",
    "dev:local": "varlock run -- concurrently -n vite,convex -c blue,green \"vite --host\" \"npx convex dev\"",
    "dev:convex:local": "varlock run -- npx convex dev",
    "build:local": "varlock run -- sh -c \"tsc -b && vite build\"",
    "build:analyze:local": "varlock run -- sh -c \"ANALYZE=true tsc -b && ANALYZE=true vite build\"",
    "typecheck:ci:local": "varlock run -- tsc -p tsconfig.ci.json --pretty false",
    "lint:local": "varlock run -- eslint .",
    "preview:local": "varlock run -- vite preview",
    "test:local": "varlock run -- vitest run",
    "test:watch:local": "varlock run -- vitest",
    "test:coverage:local": "varlock run -- vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.43",
    "@ai-sdk/react": "^3.0.118",
    "@auth/core": "^0.37.0",
    "@base-ui/react": "^1.3.0",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@convex-dev/auth": "^0.0.91",
    "@nivo/scatterplot": "^0.99.0",
    "@react-spring/web": "^10.0.3",
    "@sentry/react": "^10.50.0",
    "@tanstack/react-router": "^1.168.23",
    "@uiw/react-md-editor": "^4.0.11",
    "@xstate/react": "^5.0.5",
    "ai": "^6.0.116",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.33.1",
    "driver.js": "^1.4.0",
    "lucide-react": "^0.577.0",
    "marked": "^18.0.3",
    "posthog-js": "^1.372.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^6.12.2",
    "shadcn": "^4.0.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "umap-js": "^1.4.0",
    "xstate": "^5.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.2",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "happy-dom": "^15.11.7",
    "postcss": "^8.5.8",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^5.4.11",
    "vitest": "^4.1.2"
  }
}
